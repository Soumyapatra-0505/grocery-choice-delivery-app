# Backend Spring Boot API Base URL (defaults to production Railway API if omitted)
# For local physical device/emulator testing: http://<your-lan-ip>:8080/api or http://10.0.2.2:8080/api
EXPO_PUBLIC_API_BASE_URL=https://grocery-choice-backend-production.up.railway.app/api
EXPO_PUBLIC_API_URL=https://grocery-choice-backend-production.up.railway.app/api
